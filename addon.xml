<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<addon id="plugin.audio.amazonmedia"
       name="Amazon Media"
       version="1.1.4"
       provider-name="spacy">
  <requires>
    <import addon="xbmc.python" version="3.0.0"/>
    <import addon="script.module.mechanicalsoup" version="1.0.0"/>
    <import addon="script.module.beautifulsoup4" version="4.9.3"/>
    <import addon="script.module.requests" version="2.22.0"/>
    <import addon="script.module.inputstreamhelper" version="0.4.4" optional="true"/>
    <import addon="script.module.infotagger" version="0.0.3"/>
  </requires>
  <extension point="xbmc.python.pluginsource" library="default.py">
    <provides>audio</provides>
  </extension>
  <extension point="xbmc.service" library="service.py"/>
  <extension point="xbmc.addon.metadata">
    <platform>all</platform>
    <license>GPL-2.0-or-later</license>
    <source>https://github.com/spacys/</source>
    <forum>https://www.kodinerds.net/index.php/Thread/65849-Amazon-Mediathek/?postID=524424</forum>
    <website>https://www.amazon.de</website>
    <summary lang="en_GB">Unofficial Amazon Music Add-on</summary>
    <description lang="en_GB">Unofficial Kodi Amazon Music Add-on - Kodi extention to browse and play Amazon Music songs. An Amazon account is necessary. Inputstream Adaptiv needs to be activated and the latest widevine verion installed.</description>
    <disclaimer lang="en_GB">Some parts of this addon may not be legal in your country of residence - please check with your local laws before installing. All used images are from Amazon.</disclaimer>
    <assets>
      <icon>resources/icon.png</icon>
      <fanart>resources/fanart.jpg</fanart>
    </assets>
  </extension>
</addon>
